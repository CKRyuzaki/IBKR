# IBKR's TWS API has no API key/secret -- authentication happens when you log
# into TWS or IB Gateway itself, not through this API layer. This file exists
# only for optional local labeling/overrides. Copy to `.env` and edit; `.env`
# is gitignored.

# Optional: label shown in the dashboard header, purely cosmetic.
IBKR_ACCOUNT_LABEL=

# Optional: override any config/config.yaml value via env, e.g.:
# IBKR_DASHBOARD_IBKR__MODE=paper
